# LLM (OpenAI — used for generation in all stages)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Optional cheaper classifier (defaults to OPENAI_MODEL):
# OPENAI_CLASSIFIER_MODEL=gpt-4o-mini

# Neo4j (Phase 2+) — not required for Phase 1
# Local demo only. Change this before any shared/remote use.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Phase 4 reranker (optional)
# Default ONNX model: Xenova/ms-marco-MiniLM-L-6-v2
# RERANKER_MODEL_NAME=BAAI/bge-reranker-base
# Use lexical fallback if HuggingFace rate-limits downloads:
# RERANK_LEXICAL_ONLY=1
